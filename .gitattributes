# 统一行尾：仓库内一律 LF，避免 Windows/macOS 混用
* text=auto eol=lf

# 需要 CRLF 的脚本（Windows 原生执行）
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 需要 LF 的脚本（在 Linux 容器 / CI 里执行）
*.sh text eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.jar binary
